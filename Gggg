function importData(input){
  const file = input.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const imported = JSON.parse(e.target.result);
      if(imported && imported.trades && imported.lists){
        if(confirm('This will replace your current trades and settings with the backup file. Are you sure?')){
          data = imported;
          persist();
          toast('Data imported successfully!');
        }
      } else { alert('Invalid backup file format.'); }
    } catch(err) { alert('Error reading JSON file.'); }
    input.value = '';
  };
  reader.readAsText(file);
}

