<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0d1a10">
<title>R Journal</title>
<style>
:root{
 --bg:#081109;--panel:#0e1b11;--panel2:#122116;--line:#263a29;--text:#eef5ee;--muted:#91a294;
 --green:#73d58a;--green2:#b6e9a5;--red:#ff6d6d;--yellow:#e8c66a;--purple:#a79cff;--blue:#75a9ff;
 --shadow:0 10px 30px rgba(0,0,0,.22);--radius:14px;
}

body.theme-light {
 --bg:#f4f6f5;--panel:#ffffff;--panel2:#e9ece9;--line:#d1d8d2;--text:#1a231b;--muted:#5f6e61;
 --green:#10b981;--red:#ef4444;--shadow:0 4px 20px rgba(0,0,0,0.06);
}

body.theme-blue {
 --bg:#090d16;--panel:#101726;--panel2:#162035;--line:#202e4a;--text:#edf2f7;--muted:#8fa0be;
 --green:#38ef7d;--red:#ff5252;--shadow:0 10px 30px rgba(0,0,0,.35);
}

body.theme-gray {
 --bg:#121212;--panel:#1e1e1e;--panel2:#2a2a2a;--line:#3a3a3a;--text:#f5f5f5;--muted:#aaaaaa;
 --green:#9e9e9e;--red:#cf6679;--shadow:0 10px 30px rgba(0,0,0,.4);
}

*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;font-size:14px;transition:background 0.3s, color 0.3s}
button,input,select,textarea{font:inherit}button{cursor:pointer}
.app{display:flex;min-height:100vh}
.sidebar{width:240px;border-right:1px solid var(--line);background:var(--panel);padding:18px 14px;position:fixed;inset:0 auto 0 0;z-index:5}
.brand{display:flex;align-items:center;padding:10px 8px 25px}.brand b{font-size:17px;letter-spacing:.6px}
nav{display:grid;gap:5px}.nav{border:0;background:transparent;color:var(--text);text-align:left;padding:11px 12px;border-radius:10px;display:flex;gap:12px;align-items:center;opacity:0.8}.nav:hover,.nav.active{background:var(--panel2);color:var(--green);opacity:1}.nav span{width:18px;text-align:center;color:var(--muted)}
.main{margin-left:240px;width:calc(100% - 240px);padding:18px 22px 30px}
.top{height:48px;display:flex;justify-content:flex-end;align-items:center;margin-bottom:12px}
.topRight{display:flex;gap:10px;align-items:center}
.head{display:flex;justify-content:space-between;align-items:end;margin:10px 0 16px}.head h1{font-size:24px;margin:0}.head p{margin:5px 0 0;color:var(--muted)}

.grid6{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
.metric,.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
.metric{padding:15px;min-height:108px}.metric .label{color:var(--muted);font-size:12px}.metric .value{font-size:23px;font-weight:750;margin:8px 0}.up{color:var(--green)}.down{color:var(--red)}.sub{font-size:11px;color:var(--muted)}

.row2{display:grid;grid-template-columns:1.5fr 1fr;gap:12px;margin-top:12px}
.card{padding:15px}.card h3{font-size:14px;margin:0 0 10px}.cardHead{display:flex;justify-content:space-between;align-items:center}
.cardActions{display:flex;gap:8px;align-items:center}
.iconBtn{background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:8px;padding:6px 10px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:0.2s}
.iconBtn:hover{border-color:var(--green);color:var(--green)}
.select{background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:8px;padding:7px 10px;outline:none}
.chart{height:280px;position:relative}.chart svg{width:100%;height:100%}

/* Monthly Calendar Styles */
.calHeader{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.calHeader span{font-weight:bold;font-size:13px;color:var(--green)}
.calNavBtn{background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:6px;padding:2px 8px;cursor:pointer}
.calNavBtn:hover{border-color:var(--green)}
.calWeekDays{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center;font-size:10px;color:var(--muted);margin-bottom:4px;font-weight:bold}
.calGrid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.day{min-height:48px;border:1px solid var(--line);border-radius:7px;padding:4px 3px;text-align:center;background:var(--panel2);cursor:pointer;transition:transform 0.1s, border-color 0.1s;display:flex;flex-direction:column;justify-content:space-between;}.day:hover{transform:scale(1.04);border-color:var(--green);}.day.today{border:2px solid var(--green);box-shadow: 0 0 8px rgba(115,213,138,0.4);}.day.pos{background:rgba(115,213,138,0.15);border-color:rgba(115,213,138,0.4)}.day.neg{background:rgba(255,109,109,0.15);border-color:rgba(255,109,109,0.4)}.day.emptyDay{background:transparent;border:0;cursor:default}.day strong{display:block;font-size:10px;color:var(--muted)}.day small{font-size:10px;font-weight:bold}

/* Modal Styles */
.modalOverlay{position:fixed;inset:0;background:rgba(0,0,0,0.75);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;z-index:99;padding:20px}
.modalOverlay.active{display:flex}
.modalCard{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);width:100%;max-width:1000px;max-height:90vh;display:flex;flex-direction:column;padding:20px;box-shadow:0 20px 50px rgba(0,0,0,0.5);position:relative;overflow:hidden}
.modalHead{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;border-bottom:1px solid var(--line);padding-bottom:10px}
.modalHead h3{margin:0;font-size:18px}
.modalBody{flex:1;overflow:auto}
.modalBody .chart{height:500px}
.modalBody .calGrid{gap:8px}
.modalBody .day{min-height:75px;padding:8px}
.modalBody .day strong{font-size:12px}
.modalBody .day small{font-size:12px}

/* Clean Dropdown Style with Checkmark */
.custom-dropdown { position: relative; width: 100%; }
.dropdown-select-btn { width: 100%; background: var(--panel2); border: 1px solid var(--line); color: var(--text); border-radius: 9px; padding: 10px; text-align: left; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-size: 14px; }
.dropdown-content { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--panel); border: 1px solid var(--line); border-radius: 9px; margin-top: 4px; max-height: 160px; overflow-y: auto; z-index: 10; padding: 4px; box-shadow: var(--shadow); }
.dropdown-content.show { display: block; }
.dropdown-option { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; cursor: pointer; border-radius: 6px; font-size: 13px; color: var(--text); transition: background 0.15s; }
.dropdown-option:hover { background: var(--panel2); }
.dropdown-option .check-mark { opacity: 0; font-weight: bold; color: var(--green); font-size: 14px; }
.dropdown-option.selected .check-mark { opacity: 1; }

.stats{display:grid;grid-template-columns:repeat(7,1fr);gap:12px;margin-top:12px}.stat{padding:13px;min-height:94px}.stat .v{font-size:20px;font-weight:750;margin:8px 0 4px}
.row3{display:grid;grid-template-columns:1fr;gap:12px;margin-top:12px}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:left;font-size:12px}.table th{color:var(--muted);font-weight:500}.pill{padding:4px 7px;border-radius:12px;background:rgba(115,213,138,0.2);color:var(--green);font-size:10px}.pill.red{background:rgba(255,109,109,0.2);color:var(--red)}
.journal{max-height:280px;overflow:auto}
.page{display:none}.page.active{display:block}.sectionGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.formCard{max-width:1000px}.formGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.field label{display:block;color:var(--muted);font-size:11px;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:9px;padding:10px;outline:none}.field textarea{min-height:90px;resize:vertical}.span2{grid-column:span 2}.span3{grid-column:span 3}.actions{display:flex;gap:8px;margin-top:15px}.primary{background:var(--green);border:0;color:#0a160c;font-weight:750;border-radius:9px;padding:11px 16px}.secondary{background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:9px;padding:11px 16px}
.empty{padding:40px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:12px}
.toolbar{display:flex;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;align-items:center}
.list{display:grid;gap:9px}
.listItem{display:flex;justify-content:space-between;align-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:11px 13px}
.danger{color:var(--red);background:transparent;border:0;font-weight:bold;cursor:pointer}
.editBtn{color:var(--green);background:transparent;border:0;font-weight:bold;cursor:pointer;margin-right:8px}
.toast{position:fixed;right:20px;bottom:20px;background:var(--green);color:#000;padding:11px 15px;border-radius:10px;display:none;z-index:20;font-weight:bold}
.thumbImg{width:36px;height:36px;object-fit:cover;border-radius:4px;border:1px solid var(--line);cursor:pointer;margin-right:4px}
.dateFilter{display:flex;gap:8px;align-items:center;color:var(--muted);font-size:12px}
.dateFilter input{background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:8px;padding:6px;outline:none;font-size:12px}
.tradesSummary{display:flex;gap:15px;align-items:center;color:var(--muted);font-size:13px;background:var(--panel2);padding:8px 15px;border-radius:8px;border:1px solid var(--line);margin-bottom:10px}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
 <div class="brand"><div><b>R JOURNAL</b></div></div>
 <nav>
  <button class="nav active" data-page="dashboard"><span>⌂</span>Dashboard</button>
  <button class="nav" data-page="add"><span>＋</span>Add Trade</button>
  <button class="nav" data-page="trades"><span>☷</span>Trades</button>
  <button class="nav" data-page="analytics"><span>⌁</span>Analytics</button>
  <button class="nav" data-page="strategies"><span>◈</span>Strategies</button>
  <button class="nav" data-page="notes"><span>▣</span>Journal & Notes</button>
 </nav>
</aside>
<main class="main">
<header class="top">
  <div class="topRight">
    <label style="font-size:12px; color:var(--muted);">Theme:</label>
    <select class="select" id="themeSelect" onchange="changeTheme(this.value)">
      <option value="dark">Dark Emerald</option>
      <option value="light">Light Gray</option>
      <option value="blue">Midnight Blue</option>
      <option value="gray">Neutral Dark Gray</option>
    </select>
  </div>
</header>

<section id="dashboard" class="page active">
 <div class="head"><div><h1>Dashboard</h1><p>Your trading performance at a glance</p></div></div>
 
 <div class="grid6" id="metrics"></div>

 <div class="row2">
  <div class="card">
    <div class="cardHead">
      <h3>Performance Overview</h3>
      <div class="cardActions">
        <select class="select" id="chartTypeSelect" onchange="renderPerformanceChart()">
          <option value="r">Total R</option>
          <option value="pnl">Total PnL ($)</option>
        </select>
        <select class="select" id="rrFilterSelect" onchange="renderPerformanceChart()">
          <option value="all">RR Filter: All</option>
          <option value="weekly">RR Filter: Weekly</option>
          <option value="monthly">RR Filter: Monthly</option>
          <option value="pnl_filter">PnL Filter</option>
        </select>
        <button class="iconBtn" onclick="openModal('chart')" title="Maximize Chart">⛶</button>
      </div>
    </div>
    <div class="chart" id="performanceChart" style="margin-top:10px"></div>
  </div>
  <div class="card">
    <div class="cardHead">
      <h3>Trading Calendar</h3>
      <button class="iconBtn" onclick="openModal('calendar')" title="Maximize Calendar">⛶</button>
    </div>
    <div id="calendarGridWrapper" style="margin-top:10px"></div>
  </div>
 </div>

 <div class="stats" id="stats"></div>
 <div class="row3">
  <div class="card"><div class="cardHead"><h3>☷ Recent Trades</h3></div><div class="journal"><table class="table"><thead><tr><th>Date</th><th>Symbol</th><th>Setup</th><th>R</th><th>PnL</th><th>Result</th></tr></thead><tbody id="recent"></tbody></table></div></div>
 </div>
</section>

<!-- Fullscreen Modal Container -->
<div class="modalOverlay" id="modalOverlay" onclick="closeModalOnBg(event)">
  <div class="modalCard">
    <div class="modalHead">
      <h3 id="modalTitle">Full Screen View</h3>
      <button class="iconBtn" onclick="closeModal()">✕</button>
    </div>
    <div class="modalBody" id="modalBody"></div>
  </div>
</div>

<section id="add" class="page">
 <div class="head"><div><h1 id="formTitle">Add Trade</h1><p>Capture the trade exactly as you executed it.</p></div></div>
 <div class="card formCard"><div class="formGrid">
  <input type="hidden" id="editTradeId">
  <div class="field"><label>Date</label><input id="fDate" type="date"></div>
  <div class="field"><label>Time</label><input id="fTime" type="time"></div>
  <div class="field"><label>Symbol</label><select id="fSymbol"><option>MNQ</option><option>MES</option><option>NQ</option><option>ES</option><option>Other</option></select></div>
  
  <div class="field">
    <label>Bias (Multi-select)</label>
    <div class="custom-dropdown" id="dropBias">
      <div class="dropdown-select-btn" onclick="toggleDropdown('dropBias')">
        <span id="dropBiasText">Select options...</span> <span>▼</span>
      </div>
      <div class="dropdown-content" id="fBiasBox"></div>
    </div>
  </div>

  <div class="field"><label>Session</label><select id="fSession"><option>NY AM</option><option>NY PM</option><option>London</option><option>Asia</option></select></div>
  <div class="field"><label>Setup Grade</label><select id="fGrade"><option>A+</option><option>A</option><option>B</option><option>C</option><option>F</option></select></div>
  
  <div class="field">
    <label>Entry (Multi-select)</label>
    <div class="custom-dropdown" id="dropEntry">
      <div class="dropdown-select-btn" onclick="toggleDropdown('dropEntry')">
        <span id="dropEntryText">Select options...</span> <span>▼</span>
      </div>
      <div class="dropdown-content" id="fEntryBox"></div>
    </div>
  </div>

  <div class="field">
    <label>KL / Key Level (Multi-select)</label>
    <div class="custom-dropdown" id="dropKL">
      <div class="dropdown-select-btn" onclick="toggleDropdown('dropKL')">
        <span id="dropKLText">Select options...</span> <span>▼</span>
      </div>
      <div class="dropdown-content" id="fKLBox"></div>
    </div>
  </div>

  <div class="field">
    <label>Narrative (Multi-select)</label>
    <div class="custom-dropdown" id="dropNarrative">
      <div class="dropdown-select-btn" onclick="toggleDropdown('dropNarrative')">
        <span id="dropNarrativeText">Select options...</span> <span>▼</span>
      </div>
      <div class="dropdown-content" id="fNarrativeBox"></div>
    </div>
  </div>

  <div class="field">
    <label>Trade Status</label>
    <select id="fTradeStatus">
      <option>In-Plan</option>
      <option>Out-of-Plan</option>
      <option>Missed Trade</option>
    </select>
  </div>

  <div class="field"><label>Entry Price</label><input id="fEntryPrice" type="number" step="any"></div>
  <div class="field"><label>Exit Price</label><input id="fExitPrice" type="number" step="any"></div>
  <div class="field"><label>Position Size</label><input id="fSize" type="number" step="1"></div>
  <div class="field"><label>P&L ($)</label><input id="fPnl" type="number" step="any"></div>
  <div class="field"><label>Planned Risk ($)</label><input id="fRisk" type="number" step="any"></div>
  <div class="field"><label>Stop Loss</label><input id="fSL" type="number" step="any"></div>
  <div class="field"><label>Take Profit</label><input id="fTP" type="number" step="any"></div>
  <div class="field"><label>Planned R:R</label><input id="fRR" type="number" step="any" placeholder="2.0"></div>
  <div class="field"><label>Result (R)</label><input id="fR" type="number" step="any" placeholder="e.g. 1.5"></div>
  <div class="field"><label>Execution Quality</label><select id="fExec"><option>Excellent</option><option>Good</option><option>Average</option><option>Poor</option></select></div>
  <div class="field"><label>Confidence</label><input id="fConfidence" type="number" min="1" max="10" placeholder="1–10"></div>
  <div class="field"><label>Emotional Drift</label><select id="fEmotion"><option>Calm</option><option>Confident</option><option>FOMO</option><option>Revenge</option><option>Fear</option><option>Greed</option><option>Overtraded</option></select></div>
  <div class="field span2"><label>Plan Followed</label><select id="fPlan"><option>Yes</option><option>Partially</option><option>No</option></select></div>
  
  <div class="field span3"><label>Before Chart Image (صورة قبل الدخول)</label><input id="fChartBeforeFile" type="file" accept="image/*" onchange="encodeImage(this, 'fChartBeforeData')"><input type="hidden" id="fChartBeforeData"></div>
  <div class="field span3"><label>After Chart Image (صورة بعد الدخول)</label><input id="fChartAfterFile" type="file" accept="image/*" onchange="encodeImage(this, 'fChartAfterData')"><input type="hidden" id="fChartAfterData"></div>

  <div class="field span3"><label>Notes</label><textarea id="fNotes" placeholder="What happened? What did you learn?"></textarea></div>
 </div><div class="actions"><button class="primary" onclick="saveTrade()">Save Trade</button><button class="secondary" onclick="clearForm()">Clear / Cancel</button></div></div>
</section>

<section id="trades" class="page">
  <div class="head">
    <div><h1>Trades Log</h1><p>Your complete trade history.</p></div>
    <button class="primary" onclick="go('add')">＋ Add Trade</button>
  </div>
  <div class="card">
    <div class="toolbar">
      <div style="display:flex; gap:10px; flex:1; flex-wrap:wrap;">
        <input class="select" id="tradeSearch" placeholder="Search symbol..." oninput="renderTrades()" style="flex:1; min-width:150px;">
        <div class="dateFilter">
          From: <input type="date" id="dateFrom" onchange="renderTrades()">
          To: <input type="date" id="dateTo" onchange="renderTrades()">
        </div>
      </div>
      <select class="select" id="tradeResult" onchange="renderTrades()" style="min-width:130px;">
        <option value="All">All Results</option>
        <option value="Win">Win</option>
        <option value="Loss">Loss</option>
        <option value="Breakeven">Breakeven</option>
      </select>
    </div>

    <div id="tradesSummary" class="tradesSummary" style="display:none;">
      <span>Filtered: <strong id="summaryCount">0</strong></span>
      <span>Total R: <strong id="summaryTotalR">0.00R</strong></span>
      <span>Total P&L: <strong id="summaryTotalPnl">$0.00</strong></span>
    </div>

    <div class="journal">
      <table class="table">
        <thead>
          <tr><th>Date</th><th>Symbol</th><th>Status</th><th>Bias</th><th>Entry</th><th>KL</th><th>R</th><th>P&L</th><th>Images</th><th>Actions</th></tr>
        </thead>
        <tbody id="tradesBody"></tbody>
      </table>
    </div>
  </div>
</section>

<section id="analytics" class="page"><div class="head"><div><h1>Analytics</h1></div></div><div class="sectionGrid"><div class="card"><h3>Performance by Session</h3><div id="sessionStats"></div></div><div class="card"><h3>Performance by Bias</h3><div id="biasStats"></div></div><div class="card"><h3>Performance by Symbol</h3><div id="symbolStats"></div></div></div></section>

<section id="strategies" class="page">
  <div class="head">
    <div><h1>Strategies & Options</h1><p>Customize KL, Entry, Bias, Narrative options and manage backups.</p></div>
    <div style="display:flex; gap:8px;">
      <button class="primary" onclick="exportData()">💾 Export Backup</button>
      <button class="secondary" onclick="$('importFile').click()">📂 Import Backup</button>
      <input type="file" id="importFile" style="display:none" accept=".json" onchange="importData(this)">
    </div>
  </div>
  <div class="sectionGrid" id="strategyManager"></div>
</section>

<section id="notes" class="page"><div class="head"><div><h1>Journal & Notes</h1></div></div><div class="card"><div class="formGrid"><div class="field span3"><label>Quick Notes</label><textarea id="noteText"></textarea></div></div><div class="actions"><button class="primary" onclick="saveNote()">Save Note</button></div></div><div style="height:12px"></div><div class="card"><div class="list" id="notesList"></div></div></section>
</main></div><div class="toast" id="toast"></div>

<script>
const KEY='rjournal_pro_v11_clean';
let data=JSON.parse(localStorage.getItem(KEY)||'null')||{
 theme:'dark',trades:[],notes:[],
 lists:{KL:[],Entry:[],Bias:[],Narrative:[]}
};
const $=id=>document.getElementById(id);
let currentCalDate = new Date();

function changeTheme(theme){
 data.theme=theme;
 document.body.className='';
 if(theme==='light') document.body.classList.add('theme-light');
 if(theme==='blue') document.body.classList.add('theme-blue');
 if(theme==='gray') document.body.classList.add('theme-gray');
 persist();
}

function persist(){localStorage.setItem(KEY,JSON.stringify(data));renderAll()}
function toast(t){$('toast').textContent=t;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',1800)}
function go(page){
 document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
 $(page).classList.add('active');
 document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.page===page));
 if(page==='add' && !$('editTradeId').value) {
  const d = new Date();
  $('fDate').value = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
 }
 renderAll();scrollTo(0,0);
}
document.querySelectorAll('.nav,[data-page]').forEach(x=>x.addEventListener('click',()=>go(x.dataset.page)));
function val(id){return $(id).value}

function encodeImage(input, targetId) {
 if (input.files && input.files[0]) {
  const reader = new FileReader();
  reader.onload = function(e) { $(targetId).value = e.target.result; };
  reader.readAsDataURL(input.files[0]);
 }
}

function exportData(){
  const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(data));
  const downloadAnchor = document.createElement('a');
