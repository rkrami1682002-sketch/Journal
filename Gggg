function renderCalendar(targetId='calendarGridWrapper') {
  const el = $(targetId);
  if(!el) return;
  const year = currentCalDate.getFullYear(), month = currentCalDate.getMonth();
  const firstDay = new Date(year, month, 1).getDay(), totalDays = new Date(year, month + 1, 0).getDate();
  let daysHTML = '';
  const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  for(let i = 0; i < firstDay; i++) daysHTML += `<div class="day emptyDay"></div>`;
  for(let d = 1; d <= totalDays; d++) {
    const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    const dayTrades = data.trades.filter(t => t.date === dateStr);
    const dayR = dayTrades.reduce((sum, t) => sum + (Number(t.r) || 0), 0);
    const statusClass = dayTrades.length > 0 ? (dayR >= 0 ? 'pos' : 'neg') : '';
    const now = new Date(), todayStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    const isToday = dateStr === todayStr ? 'today' : '';
    daysHTML += `
      <div class="day ${statusClass} ${isToday}" onclick="filterTradesByDate('${dateStr}')">
        <strong>${d}</strong>
        <small>${dayTrades.length > 0 ? (dayR >= 0 ? '+' : '') + dayR.toFixed(1) + 'R' : ''}</small>
      </div>
    `;
  }
  el.innerHTML = `
    <div class="calHeader">
      <button class="calNavBtn" onclick="changeCalMonth(-1, '${targetId}')">◀</button>
      <span>${monthNames[month]} ${year}</span>
      <button class="calNavBtn" onclick="changeCalMonth(1, '${targetId}')">▶</button>
    </div>
    <div class="calWeekDays"><div>Su</div><div>Mo</div><div>Tu</div><div>We</div><div>Th</div><div>Fr</div><div>Sa</div></div>
    <div class="calGrid">${daysHTML}</div>
  `;
}

function changeCalMonth(delta, targetId) {
  currentCalDate.setMonth(currentCalDate.getMonth() + delta);
  renderCalendar(targetId);
}

