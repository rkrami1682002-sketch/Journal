<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0d1a10">
<title>R Journal Pro</title>
<style>
:root{
 --bg:#081109;--panel:#0e1b11;--panel2:#122116;--line:#263a29;--text:#eef5ee;--muted:#91a294;
 --green:#73d58a;--green2:#b6e9a5;--red:#ff6d6d;--yellow:#e8c66a;--purple:#a79cff;--blue:#75a9ff;
 --shadow:0 10px 30px rgba(0,0,0,.22);--radius:14px;
}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#071008,#0b160d 55%,#081108);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;font-size:14px}
button,input,select,textarea{font:inherit}button{cursor:pointer}
.app{display:flex;min-height:100vh}.sidebar{width:240px;border-right:1px solid var(--line);background:#09140b;padding:18px 14px;position:fixed;inset:0 auto 0 0;z-index:5}
.brand{display:flex;gap:10px;align-items:center;padding:4px 8px 22px}.brandmark{width:32px;height:30px;display:flex;align-items:end;gap:4px}.brandmark i{display:block;width:7px;background:var(--green);border-radius:3px}.brandmark i:nth-child(1){height:13px}.brandmark i:nth-child(2){height:21px}.brandmark i:nth-child(3){height:29px}.brand b{font-size:16px;letter-spacing:.6px}.brand small{display:block;color:var(--muted);font-size:10px;margin-top:3px}
nav{display:grid;gap:5px}.nav{border:0;background:transparent;color:#c8d2c9;text-align:left;padding:11px 12px;border-radius:10px;display:flex;gap:12px;align-items:center}.nav:hover,.nav.active{background:#19321c;color:#fff}.nav span{width:18px;text-align:center;color:#a8b5a9}
.sideTitle{margin:24px 8px 8px;color:#708072;font-size:11px;text-transform:uppercase;letter-spacing:1px}.mini{padding:7px 8px;color:#b8c5ba;display:flex;gap:9px;align-items:center}.dot{width:9px;height:9px;border-radius:50%;background:var(--green);display:inline-block}.sideQuote{position:absolute;bottom:18px;left:14px;right:14px;border:1px solid var(--line);padding:13px;border-radius:11px;color:#d8e4d8}.sideQuote small{color:#77877a;display:block;margin-top:6px}
.main{margin-left:240px;width:calc(100% - 240px);padding:18px 22px 30px}.top{height:48px;display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.search{width:320px;background:#0d1a10;border:1px solid var(--line);border-radius:22px;padding:10px 16px;color:#9ba99d}.topRight{display:flex;gap:10px;align-items:center}.avatar{width:32px;height:32px;border-radius:50%;background:#dce8d6;color:#172018;display:grid;place-items:center;font-weight:700}.iconBtn,.range{background:#0d1a10;border:1px solid var(--line);color:#dce5dc;border-radius:10px;padding:9px 12px}.head{display:flex;justify-content:space-between;align-items:end;margin:10px 0 16px}.head h1{font-size:24px;margin:0}.head p{margin:5px 0 0;color:var(--muted)}.filters{display:flex;gap:8px}
.grid6{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.metric,.card{background:linear-gradient(145deg,#102015,#0c180e);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.metric{padding:15px;min-height:108px}.metric .label{color:#aebcaf;font-size:12px}.metric .value{font-size:23px;font-weight:750;margin:8px 0}.up{color:var(--green)}.down{color:var(--red)}.sub{font-size:11px;color:var(--muted)}
.row2{display:grid;grid-template-columns:1.4fr 1fr .72fr;gap:12px;margin-top:12px}.card{padding:15px}.card h3{font-size:14px;margin:0 0 10px}.cardHead{display:flex;justify-content:space-between;align-items:center}.select{background:#0b170d;border:1px solid var(--line);color:#dce6dc;border-radius:8px;padding:7px 10px}
.chart{height:260px;position:relative}.chart svg{width:100%;height:100%}.legend{display:flex;gap:18px;color:#aab8ad;font-size:11px;margin-bottom:3px}.legend b{color:var(--green)}.calendar{height:260px}.calHead{display:grid;grid-template-columns:repeat(7,1fr);color:#7e8c80;font-size:10px;text-align:center;margin:8px 0 5px}.calGrid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}.day{min-height:34px;border:1px solid #243725;border-radius:7px;padding:4px 5px;text-align:center;background:#132418}.day.pos{background:#173b21}.day.neg{background:#351b1c}.day.muted{opacity:.4}.day strong{display:block;font-size:10px}.day small{font-size:10px}.bestgrid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.miniCard{border:1px solid var(--line);border-radius:11px;padding:12px;background:#102015;min-height:115px}.miniCard .big{font-size:20px;font-weight:750;margin-top:8px}.miniCard small{color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(7,1fr);gap:12px;margin-top:12px}.stat{padding:13px;min-height:94px}.stat .v{font-size:20px;font-weight:750;margin:8px 0 4px}
.row3{display:grid;grid-template-columns:1.15fr .9fr 1.05fr;gap:12px;margin-top:12px}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:8px 5px;border-bottom:1px solid #203021;text-align:left;font-size:11px}.table th{color:#7f8e81;font-weight:500}.pill{padding:4px 7px;border-radius:12px;background:#173d20;color:var(--green);font-size:10px}.pill.red{background:#3a1d1f;color:#ff8b8b}.donut{display:flex;align-items:center;gap:18px}.donutCircle{width:135px;height:135px;border-radius:50%;background:conic-gradient(#76d88b 0 32%,#9be3a0 32% 53%,#e6b15b 53% 65%,#ef6666 65% 75%,#b58adf 75% 83%,#6da7ef 83% 89%,#809487 89% 94%,#8c8df0 94% 100%);position:relative}.donutCircle:after{content:"48";position:absolute;inset:26px;border-radius:50%;background:#0d1a10;display:grid;place-items:center;font-size:22px;font-weight:750}.donutCircle:before{content:"Total Trades";position:absolute;z-index:1;top:78px;left:37px;color:#849285;font-size:9px}
.journal{max-height:220px;overflow:auto}.bottomActions{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:12px}.action{padding:15px;background:#101f13;border:1px solid var(--line);border-radius:11px;color:#dce6dd;text-align:left}.action:hover{background:#17331b}
.page{display:none}.page.active{display:block}.sectionGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.formCard{max-width:1000px}.formGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.field label{display:block;color:#a8b6aa;font-size:11px;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;background:#0a160c;border:1px solid #29402c;color:#eaf2eb;border-radius:9px;padding:10px;outline:none}.field textarea{min-height:90px;resize:vertical}.span2{grid-column:span 2}.span3{grid-column:span 3}.actions{display:flex;gap:8px;margin-top:15px}.primary{background:#70d584;border:0;color:#0a160c;font-weight:750;border-radius:9px;padding:11px 16px}.secondary{background:#122116;border:1px solid var(--line);color:#dce6dd;border-radius:9px;padding:11px 16px}
.empty{padding:40px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:12px}.toolbar{display:flex;justify-content:space-between;gap:10px;margin-bottom:12px}.list{display:grid;gap:9px}.listItem{display:flex;justify-content:space-between;align-items:center;background:#0f1d11;border:1px solid var(--line);border-radius:10px;padding:11px 13px}.listItem .actions{margin:0}.danger{color:#ff8585;background:transparent;border:0}.tabbar{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}.tab{background:#0f1d11;color:#aab8ad;border:1px solid var(--line);padding:8px 12px;border-radius:8px}.tab.active{background:#19351d;color:#fff}
.toast{position:fixed;right:20px;bottom:20px;background:#d9ecd7;color:#112013;padding:11px 15px;border-radius:10px;display:none;z-index:20}
@media(max-width:1200px){.grid6{grid-template-columns:repeat(3,1fr)}.row2{grid-template-columns:1fr}.stats{grid-template-columns:repeat(4,1fr)}.row3{grid-template-columns:1fr}.sectionGrid{grid-template-columns:1fr 1fr}}
@media(max-width:800px){.sidebar{width:70px;padding:12px 8px}.brand b,.brand small,.nav span+*,.sideTitle,.mini,.sideQuote{display:none}.brand{justify-content:center}.main{margin-left:70px;width:calc(100% - 70px);padding:12px}.top .search{width:160px}.grid6{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}.formGrid{grid-template-columns:1fr}.span2,.span3{grid-column:auto}.bottomActions{grid-template-columns:1fr 1fr}.head{align-items:start;gap:10px;flex-direction:column}.filters{width:100%}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
 <div class="brand"><div class="brandmark"><i></i><i></i><i></i></div><div><b>R JOURNAL PRO</b><small>Trade Smarter · Improve Faster</small></div></div>
 <nav>
  <button class="nav active" data-page="dashboard"><span>⌂</span>Dashboard</button>
