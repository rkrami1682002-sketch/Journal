<section id="dashboard" class="page active">
 <div class="head"><div><h1>Dashboard</h1><p>Your trading performance at a glance</p></div><div class="filters"><button class="range">▣ Jan 1, 2026 → Jan 31, 2026⌄</button><button class="range">This Month⌄</button></div></div>
 <div class="grid6" id="metrics"></div>
 <div class="row2">
  <div class="card"><div class="cardHead"><h3>Performance Overview</h3><select class="select"><option>R</option><option>P&L</option></select></div><div class="legend"><b>● Total R</b><span>● P&L</span></div><div class="chart"><svg viewBox="0 0 650 260" preserveAspectRatio="none"><g stroke="#243826" stroke-width="1"><line x1="40" y1="30" x2="630" y2="30"/><line x1="40" y1="80" x2="630" y2="80"/><line x1="40" y1="130" x2="630" y2="130"/><line x1="40" y1="180" x2="630" y2="180"/><line x1="40" y1="230" x2="630" y2="230"/></g><path d="M40 218 L65 198 L90 205 L115 178 L140 190 L165 150 L190 169 L215 130 L240 145 L265 143 L290 120 L315 132 L340 108 L365 117 L390 104 L415 91 L440 74 L465 35 L490 66 L515 45 L540 31 L565 46 L590 20 L615 52 L630 36 L630 230 L40 230Z" fill="#75d58a" opacity=".12"/><polyline points="40,218 65,198 90,205 115,178 140,190 165,150 190,169 215,130 240,145 265,143 290,120 315,132 340,108 365,117 390,104 415,91 440,74 465,35 490,66 515,45 540,31 565,46 590,20 615,52 630,36" fill="none" stroke="#74d68a" stroke-width="3"/><polyline points="40,225 65,218 90,220 115,207 140,212 165,196 190,201 215,188 240,190 265,193 290,181 315,185 340,174 365,180 390,164 415,158 440,148 465,126 490,140 515,126 540,112 565,121 590,105 615,116 630,106" fill="none" stroke="#9aa89b" stroke-width="2"/></svg></div></div>
  <div class="card"><div class="cardHead"><h3>Trading Calendar</h3><b style="color:#9bab9c">January 2026</b></div><div class="calHead"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div class="calGrid" id="calendarGrid"></div></div>
  <div class="card"><h3>🏆 Best & Worst Days</h3><div class="bestgrid"><div class="miniCard"><small>🏆 Best Day</small><div>Jan 20, 2026</div><div class="big up">+3.6R</div></div><div class="miniCard"><small>⚠ Worst Day</small><div>Jan 16, 2026</div><div class="big down">-2.3R</div></div><div class="miniCard"><small>🎯 Best Setup</small><div>Liquidity Sweep + BOS</div><div class="big up">+6.8R</div><small>4 trades</small></div><div class="miniCard"><small>⚠ Worst Setup</small><div>News Trading</div><div class="big down">-4.2R</div><small>3 trades</small></div></div></div>
 </div>
 <div class="stats" id="stats"></div>
 <div class="row3">
  <div class="card"><div class="cardHead"><h3>Strategies Performance</h3><select class="select" id="strategyFilter"><option>All Strategies</option></select></div><table class="table"><thead><tr><th>Strategy</th><th>Trades</th><th>Win Rate</th><th>Total R</th><th>Avg R:R</th></tr></thead><tbody id="strategyTable"></tbody></table></div>
  <div class="card"><div class="cardHead"><h3>◉ Psychology & Emotions</h3><a style="color:#8bd99b">View Details</a></div><div class="donut"><div class="donutCircle"></div><div id="psych"></div></div></div>
  <div class="card"><div class="cardHead"><h3>☷ Trade Journal</h3><a style="color:#8bd99b">View All</a></div><div class="journal"><table class="table"><thead><tr><th>Date</th><th>Symbol</th><th>Setup</th><th>R</th><th>PnL</th><th>Result</th></tr></thead><tbody id="recent"></tbody></table></div></div>
 </div>
 <div class="bottomActions"><button class="action" data-page="notes">▣ &nbsp; Quick Notes　›</button><button class="action" data-page="notes">☼ &nbsp; Daily Review　›</button><button class="action" data-page="analytics">⚠ &nbsp; Mistakes　›</button><button class="action" data-page="notes">▥ &nbsp; Lessons Learned　›</button><button class="action" data-page="notes">◎ &nbsp; One Fix For Next Time　›</button></div>
</section>

<section id="add" class="page">
 <div class="head"><div><h1>Add Trade</h1><p>Capture the trade exactly as you executed it.</p></div></div>
 <div class="card formCard"><div class="formGrid">
  <div class="field"><label>Date</label><input id="fDate" type="date"></div><div class="field"><label>Time</label><input id="fTime" type="time"></div><div class="field"><label>Symbol</label><select id="fSymbol"><option>MNQ</option><option>MES</option><option>NQ</option><option>ES</option><option>Other</option></select></div>
  <div class="field"><label>Bias</label><select id="fBias"></select></div><div class="field"><label>Session</label><select id="fSession"><option>NY AM</option><option>NY PM</option><option>London</option><option>Asia</option></select></div><div class="field"><label>Setup Grade</label><select id="fGrade"><option>A+</option><option>A</option><option>B</option><option>C</option><option>F</option></select></div>
  <div class="field"><label>Entry</label><select id="fEntry"></select></div><div class="field"><label>Entry Price</label><input id="fEntryPrice" type="number" step="any"></div><div class="field"><label>Exit Price</label><input id="fExitPrice" type="number" step="any"></div>
  <div class="field"><label>Position Size</label><input id="fSize" type="number" step="1"></div><div class="field"><label>P&L ($)</label><input id="fPnl" type="number" step="any"></div><div class="field"><label>Planned Risk ($)</label><input id="fRisk" type="number" step="any"></div>
  <div class="field"><label>Stop Loss</label><input id="fSL" type="number" step="any"></div><div class="field"><label>Take Profit</label><input id="fTP" type="number" step="any"></div><div class="field"><label>Planned R:R</label><input id="fRR" type="number" step="any" placeholder="2.0"></div>
  <div class="field"><label>Result (R)</label><input id="fR" type="number" step="any" placeholder="e.g. 1.5"></div><div class="field"><label>Execution Quality</label><select id="fExec"><option>Excellent</option><option>Good</option><option>Average</option><option>Poor</option></select></div><div class="field"><label>Confidence</label><input id="fConfidence" type="number" min="1" max="10" placeholder="1–10"></div>
  <div class="field"><label>Emotional Drift</label><select id="fEmotion"><option>Calm</option><option>Confident</option><option>FOMO</option><option>Revenge</option><option>Fear</option><option>Greed</option><option>Overtraded</option><option>Anxious</option><option>Hesitant</option><option>Frustrated</option></select></div><div class="field"><label>Plan Followed</label><select id="fPlan"><option>Yes</option><option>Partially</option><option>No</option></select></div>
  <div class="field span3"><label>Notes</label><textarea id="fNotes" placeholder="What happened? What did you learn?"></textarea></div>
  <div class="field"><label>Before Chart</label><input id="fBefore" type="file" accept="image/*"></div><div class="field"><label>After Chart</label><input id="fAfter" type="file" accept="image/*"></div>
 </div><div class="actions"><button class="primary" onclick="saveTrade()">Save Trade</button><button class="secondary" onclick="clearForm()">Clear</button></div></div>
</section>

<section id="trades" class="page"><div class="head"><div><h1>Trades</h1><p>Your complete trade history.</p></div><button class="primary" onclick="go('add')">＋ Add Trade</button></div><div class="card"><div class="toolbar"><input class="select" id="tradeSearch" placeholder="Search symbol, entry, bias..."><select class="select" id="tradeResult"><option>All Results</option><option>Win</option><option>Loss</option><option>Breakeven</option></select></div><table class="table"><thead><tr><th>Date</th><th>Time</th><th>Symbol</th><th>Bias</th><th>Entry</th><th>R</th><th>P&L</th><th>Emotion</th><th>Result</th></tr></thead><tbody id="tradesBody"></tbody></table></div></section>

<section id="missed" class="page"><div class="head"><div><h1>Missed Trades</h1><p>Track valid opportunities without contaminating actual performance.</p></div></div><div class="card"><div class="formGrid"><div class="field"><label>Date</label><input id="mDate" type="date"></div><div class="field"><label>Symbol</label><input id="mSymbol" placeholder="MNQ"></div><div class="field"><label>Setup</label><input id="mSetup" placeholder="Liquidity Sweep"></div><div class="field"><label>Bias</label><input id="mBias" placeholder="Long"></div><div class="field"><label>Planned Entry</label><input id="mEntry"></div><div class="field"><label>Potential R:R</label><input id="mRR"></div><div class="field span3"><label>Why missed?</label><textarea id="mWhy"></textarea></div></div><div class="actions"><button class="primary" onclick="saveMissed()">Save Missed Trade</button></div></div><div style="height:12px"></div><div class="card"><table class="table"><thead><tr><th>Date</th><th>Symbol</th><th>Setup</th><th>Bias</th><th>Potential R:R</th><th>Why</th></tr></thead><tbody id="missedBody"></tbody></table></div></section>

<section id="analytics" class="page"><div class="head"><div><h1>Analytics</h1><p>Find the patterns behind your results.</p></div></div><div class="sectionGrid"><div class="card"><h3>Performance by Session</h3><div id="sessionStats"></div></div><div class="card"><h3>Performance by Bias</h3><div id="biasStats"></div></div><div class="card"><h3>Performance by Symbol</h3><div id="symbolStats"></div></div></div><div style="height:12px"></div><div class="card"><h3>Trading Performance Coach</h3><p id="coach" style="color:#b9c6bb;line-height:1.7"></p></div></section>

<section id="strategies" class="page"><div class="head"><div><h1>Strategies</h1><p>Customize KL, Entry and Bias values used in Add Trade.</p></div></div><div class="sectionGrid" id="strategyManager"></div></section>

<section id="rules" class="page"><div class="head"><div><h1>Rules</h1><p>Your trading rules and violation patterns.</p></div></div><div class="card"><div class="toolbar"><input id="ruleInput" class="select" placeholder="Add a rule"><button class="primary" onclick="addRule()">Add Rule</button></div><div class="list" id="rulesList"></div></div></section>

<section id="notes" class="page"><div class="head"><div><h1>Journal & Notes</h1><p>Daily review, lessons and the one fix for next time.</p></div></div><div class="card"><div class="formGrid"><div class="field span3"><label>Quick Notes</label><textarea id="noteText" placeholder="Write your review..."></textarea></div><div class="field"><label>Daily Review Score</label><select id="noteScore"><option>10</option><option>9</option><option>8</option><option>7</option><option>6</option><option>5</option></select></div><div class="field span2"><label>One Fix For Next Time</label><input id="noteFix" class="select" placeholder="Example: Stop after 2 consecutive losses"></div></div><div class="actions"><button class="primary" onclick="saveNote()">Save Review</button></div></div><div style="height:12px"></div><div class="card"><div class="list" id="notesList"></div></div></section>

<section id="settings" class="page"><div class="head"><div><h1>Settings</h1><p>Journal preferences and data controls.</p></div></div><div class="sectionGrid">
<div class="card"><h3>Account Size</h3><p style="color:var(--muted)">Set the account size used for performance percentages.</p><div class="field"><label>Account Size ($)</label><input id="accountSizeInput" type="number" min="0" step="100" placeholder="25000"></div><div class="actions"><button class="primary" onclick="saveAccountSize()">Save Account Size</button></div><div id="accountSizeStatus" style="color:var(--muted);margin-top:8px"></div></div>
<div class="card"><h3>Appearance</h3><p style="color:var(--muted)">Dark olive trading-platform theme, optimized for iPad and Safari.</p></div>
<div class="card"><h3>Data</h3><p style="color:var(--muted)">Everything is stored locally in this browser.</p><button class="danger" onclick="resetAll()">Reset all local data</button></div>
</div></section>
</main></div><div class="toast" id="toast"></div>

<script>
const KEY='rjournal_pro_v5';
let data=JSON.parse(localStorage.getItem(KEY)||'null')||{
 accountSize:25000,trades:[],missed:[],backtests:[],rules:['Protect risk per trade','No revenge trading','Stop after 2 consecutive losses'],notes:[],
 lists:{KL:['HTF Trend','SMC / ICT','Liquidity','News/Volatility','Scalping'],Entry:['Liquidity Sweep','BOS','Pullback','Breakout','Reversal'],Bias:['Long','Short','Neutral']}
};
const $=id=>document.getElementById(id);
function persist(){localStorage.setItem(KEY,JSON.stringify(data));renderAll()}
function toast(t){$('toast').textContent=t;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',1800)}
function go(page){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));$(page).classList.add('active');document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.page===page));renderAll();scrollTo(0,0)}
document.querySelectorAll('.nav,[data-page]').forEach(x=>x.addEventListener('click',()=>go(x.dataset.page)));
function val(id){return $(id).value}
function saveTrade(){
 const t={id:Date.now(),date:val('fDate')||new Date().toISOString().slice(0,10),time:val('fTime'),symbol:val('fSymbol'),bias:val('fBias'),session:val('fSession'),grade:val('fGrade'),entry:val('fEntry'),entryPrice:+val('fEntryPrice')||0,exitPrice:+val('fExitPrice')||0,size:+val('fSize')||0,pnl:+val('fPnl')||0,risk:+val('fRisk')||0,sl:+val('fSL')||0,tp:+val('fTP')||0,plannedRR:+val('fRR')||0,r:+val('fR')||0,exec:val('fExec'),confidence:+val('fConfidence')||0,emotion:val('fEmotion'),plan:val('fPlan'),notes:val('fNotes')};
 data.trades.unshift(t);persist();clearForm();toast('Trade saved')}
function clearForm(){['fTime','fEntryPrice','fExitPrice','fSize','fPnl','fRisk','fSL','fTP','fRR','fR','fConfidence','fNotes'].forEach(id=>$(id).value='');}
function stats(){
 let ts=data.trades, r=ts.reduce((a,t)=>a+t.r,0), pnl=ts.reduce((a,t)=>a+t.pnl,0), wins=ts.filter(t=>t.r>0),loss=ts.filter(t=>t.r<0);
 let pf=loss.length?wins.reduce((a,t)=>a+t.r,0)/Math.abs(loss.reduce((a,t)=>a+t.r,0)):wins.length?Infinity:0;
 let wr=ts.length?wins.length/ts.length*100:0, avg=ts.length?r/ts.length:0, avgWin=wins.length?wins.reduce((a,t)=>a+t.r,0)/wins.length:0,avgLoss=loss.length?loss.reduce((a,t)=>a+t.r,0)/loss.length:0;
 let peak=0,eq=0,dd=0;ts.slice().reverse().forEach(t=>{eq+=t.r;peak=Math.max(peak,eq);dd=Math.min(dd,eq-peak)});
 return {ts,r,pnl,wins,loss,pf,wr,avg,avgWin,avgLoss,dd};
}
function renderMetrics(){let s=stats();let pct=s.accountPct;let arr=[['Total R',s.r.toFixed(1)+'R','Performance in R-multiple','up'],['Total P&L','$'+Math.round(s.pnl).toLocaleString(),pct.toFixed(2)+'% of account','up'],['Win Rate',s.wr.toFixed(1)+'%','Winning trades','up'],['Average R:R',avgRR(),'Planned reward / risk','up'],['Profit Factor',s.pf===Infinity?'∞':s.pf.toFixed(2),'Gross profit / gross loss','up'],['Max Drawdown',s.dd.toFixed(1)+'R','Peak-to-trough','down']];$('metrics').innerHTML=arr.map(x=>`<div class="metric"><div class="label">${x[0]}</div><div class="value ${x[3]}">${x[1]}</div><div class="sub">${x[2]}</div></div>`).join('')}
function avgRR(){let a=data.trades.filter(t=>t.plannedRR>0);return a.length?'1 : '+(a.reduce((s,t)=>s+t.plannedRR,0)/a.length).toFixed(1):'1 : 0.0'}
function renderStats(){let s=stats(),cw=0,cl=0,maxw=0,maxl=0;s.ts.slice().reverse().forEach(t=>{if(t.r>0){cw++;cl=0}else if(t.r<0){cl++;cw=0}else{cw=0;cl=0}maxw=Math.max(maxw,cw);maxl=Math.max(maxl,cl)});let a=[['Total Trades',s.ts.length,''],['Winning Trades',s.wins.length,s.wr.toFixed(1)+'%'],['Losing Trades',s.loss.length,(100-s.wr).toFixed(1)+'%'],['Avg Win','+'+s.avgWin.toFixed(1)+'R','per trade'],['Avg Loss',s.avgLoss.toFixed(1)+'R','per trade'],['Max Consecutive Wins',maxw,'(R)'],['Max Consecutive Losses',maxl,'(R)']];$('stats').innerHTML=a.map((x,i)=>`<div class="metric stat"><div class="label">${x[0]}</div><div class="v ${i==2||i==4||i==6?'down':i==1||i==3?'up':''}">${x[1]}</div><div class="sub">${x[2]}</div></div>`).join('')}
function renderCalendar(id){let vals={1:2.4,2:-1.6,3:0,4:.7,5:1.9,6:.5,7:3.2,8:-1.2,9:2.1,10:.8,11:-.4,12:2.8,13:-.6,14:1.4,15:.9,16:-2.3,17:1.7,18:0,19:3.6,20:1.1,21:-.9,22:2.7,23:1.3,24:-1.8,25:.5,26:1.9,27:.7,28:-1.4,29:2.6,30:.8,31:1.2};let days=[];for(let i=0;i<3;i++)days.push('<div class="day muted"><strong>'+[29,30,31][i]+'</strong><small></small></div>');for(let d=1;d<=31;d++){let r=vals[d];days.push(`<div class="day ${r>0?'pos':r<0?'neg':''}"><strong>${d}</strong><small class="${r<0?'down':'up'}">${r>0?'+':''}${r.toFixed(1)}R</small></div>`)}$(id).innerHTML=days.join('')}
function renderStrategies(){let body=$('strategyTable'), names=data.lists.KL;body.innerHTML=names.map((n,i)=>{let ts=data.trades.filter(t=>t.entry===n||t.notes?.toLowerCase().includes(n.toLowerCase()));let w=ts.filter(t=>t.r>0);let rr=ts.filter(t=>t.plannedRR>0);let r=ts.reduce((s,t)=>s+t.r,0);return `<tr><td><span class="dot" style="background:${['#73d58a','#75a9ff','#a79cff','#e6a85f','#ed5d8b'][i%5]}"></span> ${n}</td><td>${ts.length}</td><td>${ts.length?(w.length/ts.length*100).toFixed(0):0}%</td><td class="${r>=0?'up':'down'}">${r>=0?'+':''}${r.toFixed(1)}R</td><td>1:${rr.length?(rr.reduce((s,t)=>s+t.plannedRR,0)/rr.length).toFixed(1):'0.0'}</td></tr>`}).join('')}
function renderPsych(){let counts={Calm:32,Confident:21,Fomo:12,Revenge:10,Fear:8,Greed:8,Overtraded:6,Anxious:4};$('psych').innerHTML=Object.entries(counts).map(([k,v])=>`<div style="display:flex;justify-content:space-between;gap:25px;font-size:11px;margin:5px 0"><span>● ${k}</span><span>${v}%</span></div>`).join('')}
function renderRecent(){let ts=data.trades.slice(0,5);$('recent').innerHTML=ts.length?ts.map(t=>`<tr><td>${t.date||'-'}</td><td>${t.symbol}</td><td>${t.entry||'-'}</td><td class="${t.r>=0?'up':'down'}">${t.r>=0?'+':''}${t.r.toFixed(1)}</td><td class="${t.pnl>=0?'up':'down'}">${t.pnl>=0?'+':''}$${t.pnl}</td><td><span class="pill ${t.r<0?'red':''}">${t.r>0?'Win':t.r<0?'Loss':'BE'}</span></td></tr>`).join(''):'<tr><td colspan="6" class="empty">No trades yet — add your first trade.</td></tr>'}
function renderTrades(){let q=($('tradeSearch')?.value||'').toLowerCase(),res=$('tradeResult')?.value||'All Results';$('tradesBody').innerHTML=data.trades.filter(t=>(!q||JSON.stringify(t).toLowerCase().includes(q))&&(res==='All Results'||(res==='Win'&&t.r>0)||(res==='Loss'&&t.r<0)||(res==='Breakeven'&&t.r===0))).map(t=>`<tr><td>${t.date}</td><td>${t.time||'-'}</td><td>${t.symbol}</td><td>${t.bias}</td><td>${t.entry||'-'}</td><td class="${t.r>=0?'up':'down'}">${t.r>=0?'+':''}${t.r}</td><td class="${t.pnl>=0?'up':'down'}">$${t.pnl}</td><td>${t.emotion}</td><td><span class="pill ${t.r<0?'red':''}">${t.r>0?'Win':t.r<0?'Loss':'BE'}</span></td></tr>`).join('')||'<tr><td colspan="9" class="empty">No matching trades.</td></tr>'}
function renderManager(){let root=$('strategyManager');root.innerHTML=['KL','Entry','Bias'].map(type=>`<div class="card"><div class="cardHead"><h3>${type}</h3></div><div class="toolbar" style="margin-top:10px"><input class="select" id="new${type}" placeholder="Add ${type} value"><button class="primary" onclick="addList('${type}')">＋ Add</button></div><div class="list" style="margin-top:10px">${data.lists[type].map((x,i)=>`<div class="listItem"><span>${x}</span><button class="danger" onclick="removeList('${type}',${i})">Delete</button></div>`).join('')}</div></div>`).join('');$('sideStrategies').innerHTML=data.lists.KL.map(x=>`<div class="mini"><span class="dot"></span>${x}</div>`).join('');['fBias','fEntry'].forEach(id=>{let type=id==='fBias'?'Bias':'Entry';$(id).innerHTML=data.lists[type].map(x=>`<option>${x}</option>`).join('')});$('strategyFilter').innerHTML='<option>All Strategies</option>'+data.lists.KL.map(x=>`<option>${x}</option>`).join('')}
function addList(type){const el=$('new'+type);const v=(el?.value||'').trim();if(!v){toast('Enter a value first');return}if(!data.lists[type].includes(v))data.lists[type].push(v);persist();toast(type+' added')}}function removeList(type,i){data.lists[type].splice(i,1);persist()}
function renderRules(){$('rulesList').innerHTML=data.rules.map((r,i)=>`<div class="listItem"><span>${r}</span><button class="danger" onclick="data.rules.splice(${i},1);persist()">Delete</button></div>`).join('')};function addRule(){let x=val('ruleInput');if(x.trim()){data.rules.push(x.trim());$('ruleInput').value='';persist()}}
function saveMissed(){data.missed.unshift({date:val('mDate'),symbol:val('mSymbol'),setup:val('mSetup'),bias:val('mBias'),entry:val('mEntry'),rr:val('mRR'),why:val('mWhy')});persist();toast('Missed trade saved')}
function renderMissed(){$('missedBody').innerHTML=data.missed.map(m=>`<tr><td>${m.date}</td><td>${m.symbol}</td><td>${m.setup}</td><td>${m.bias}</td><td>${m.rr}</td><td>${m.why}</td></tr>`).join('')||'<tr><td colspan="6" class="empty">No missed trades yet.</td></tr>'}
function saveBacktest(){data.backtests.unshift({date:val('bDate'),symbol:val('bSymbol'),setup:val('bSetup'),r:val('bR'),notes:val('bNotes')});persist();toast('Backtest saved')}
function renderBacktest(){$('backtestBody').innerHTML=data.backtests.map(b=>`<tr><td>${b.date}</td><td>${b.symbol}</td><td>${b.setup}</td><td>${b.r}R</td><td>${b.notes}</td></tr>`).join('')||'<tr><td class="empty">No backtests yet.</td></tr>'}
function saveNote(){data.notes.unshift({date:new Date().toISOString().slice(0,10),score:val('noteScore'),text:val('noteText'),fix:val('noteFix')});persist();toast('Review saved')}
function renderNotes(){$('notesList').innerHTML=data.notes.map(n=>`<div class="listItem"><div><b>${n.date}</b><div style="color:#aebcaf;margin-top:4px">${n.text}</div><div class="up" style="margin-top:4px">One Fix: ${n.fix||'-'}</div></div><span>${n.score}/10</span></div>`).join('')||'<div class="empty">No reviews yet.</div>'}
function groupStats(key){let map={};data.trades.forEach(t=>{let k=t[key]||'Unknown';map[k]??=[];map[k].push(t)});return Object.entries(map).map(([k,a])=>`<div class="listItem"><span>${k}</span><b class="${a.reduce((s,t)=>s+t.r,0)>=0?'up':'down'}">${a.reduce((s,t)=>s+t.r,0).toFixed(1)}R · ${a.length} trades</b></div>`).join('')||'<div class="empty">Add trades to see patterns.</div>'}
function renderAnalytics(){ $('sessionStats').innerHTML=groupStats('session');$('biasStats').innerHTML=groupStats('bias');$('symbolStats').innerHTML=groupStats('symbol');let s=stats();$('coach').textContent=s.ts.length<10?'Keep logging trades. After enough data, the Coach will highlight your strongest edge, most expensive mistake, best session and recurring psychology pattern.':`You have ${s.ts.length} trades with ${s.wr.toFixed(1)}% wins and ${s.r.toFixed(1)}R total. Focus on the setups and sessions with the strongest positive R, and review recurring negative emotions or rule violations before increasing size.`}
function exportJSON(){let blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='r-journal-pro-backup.json';a.click()}
function exportCSV(){let rows=[['Date','Time','Symbol','Bias','Entry','R','PnL','Session','Emotion','Plan']].concat(data.trades.map(t=>[t.date,t.time,t.symbol,t.bias,t.entry,t.r,t.pnl,t.session,t.emotion,t.plan]));let csv=rows.map(r=>r.map(x=>`"${String(x??'').replaceAll('"','""')}"`).join(',')).join('\\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='r-journal-pro-trades.csv';a.click()}
function importJSON(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{data=JSON.parse(r.result);persist();toast('Backup restored')}catch{toast('Invalid backup')}};r.readAsText(f)}
function resetAll(){if(confirm('Reset all local journal data?')){localStorage.removeItem(KEY);location.reload()}}
function saveAccountSize(){const n=Number($('accountSizeInput').value);if(!Number.isFinite(n)||n<0){toast('Enter a valid account size');return}data.accountSize=n;persist();toast('Account size saved')}function renderAccountSize(){if($('accountSizeInput'))$('accountSizeInput').value=data.accountSize||0;if($('accountSizeStatus'))$('accountSizeStatus').textContent='Current account size: $'+Math.round(data.accountSize||0).toLocaleString()}function renderAll(){renderMetrics();renderStats();renderCalendar('calendarGrid');renderCalendar('bigCalendar');renderStrategies();renderPsych();renderRecent();renderTrades();renderMissed();renderManager();renderRules();renderNotes();renderAnalytics();renderAccountSize();let s=stats();$('reportSummary').innerHTML=`<div class="big up">${s.r.toFixed(1)}R</div><p style="color:var(--muted)">$${Math.round(s.pnl).toLocaleString()} P&L · ${s.ts.length} trades · ${s.wr.toFixed(1)}% WR</p>`}
$('tradeSearch').addEventListener('input',renderTrades);$('tradeResult').addEventListener('change',renderTrades);renderAll();
</script>
</body></html>
